          "attributes": {
            "code": "/**\r\n * Handler that will be called during the execution of a PostLogin flow.\r\n */\r\n exports.onExecutePostLogin = async (event, api) =\u003e {\r\n   api.user.setAppMetadata('last_login_dev', new Date().toISOString());\r\n };\r\n",
